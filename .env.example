# ===== 必填 =====
# Anthropic Claude API Key（AI 讲义生成、引导教学、批改）
ANTHROPIC_API_KEY=
# Azure AI Speech（马来语 ms-MY 语音合成 / 识别 / 发音评测）
AZURE_SPEECH_KEY=
# Azure Speech 资源所在区域，如 southeastasia / eastasia / eastus
AZURE_SPEECH_REGION=southeastasia

# ===== 可选 =====
# 使用的 Claude 模型（默认 claude-opus-5-5）
CLAUDE_MODEL=claude-opus-5-5
# 设置后访问网页需要输入此密码（部署到公网时强烈建议设置）
APP_PASSWORD=
PORT=3000
# 数据保存目录（课程、进度、语音缓存）
DATA_DIR=./data
